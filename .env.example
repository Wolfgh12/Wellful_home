# Django Core Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Domains & Security (comma-separated, no spaces)
ALLOWED_HOSTS=wellfulhome.com,www.wellfulhome.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://wellfulhome.com,https://www.wellfulhome.com

# PostgreSQL Database (Coolify Internal Network or Managed Host)
DB_NAME=wellful_home_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=postgres
DB_PORT=5432